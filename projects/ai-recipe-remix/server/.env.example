# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored: never commit a real key.

# Required for live generation. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional settings (these are the defaults)
PORT=8080
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=low
# webp | jpeg | png
OPENAI_IMAGE_FORMAT=webp
# 0-2, or "default" to let the model use its own (needed for models that reject temperature)
OPENAI_TEMPERATURE=0.7

# Comma-separated frontend origins allowed to call the API (no trailing slash).
# Defaults to the local Vite dev/preview servers. In production list your real site, e.g.
# ALLOWED_ORIGINS=https://your-site.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to 1 when the server runs behind one reverse proxy (Render, Railway, Fly.io),
# so rate limiting sees each visitor's real IP instead of the proxy's.
TRUST_PROXY=

# Requests per IP per 15 minutes
RATE_LIMIT_RECIPES=20
RATE_LIMIT_IMAGES=30
